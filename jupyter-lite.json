{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "Forensic Classification Challenge",
    "appVersion": "1.0.0",
    "defaultKernelName": "python",
    "contentsStorageName": "forensic-ml-challenge-storage",
    "settingsOverrides": {
      "@jupyterlab/apputils-extension:themes": {
        "theme": "JupyterLab Light"
      }
    },
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "disablePyPIFallback": true,
        "loadPyodideOptions": {
          "packages": [
            "python-dateutil",
            "pandas",
            "scikit-learn"
          ]
        }
      }
    }
  },
  "PyodideAddon": {
    "pyodide_url": "https://github.com/pyodide/pyodide/releases/download/314.0.1/pyodide-core-314.0.1.tar.bz2"
  },
  "PyodideLockAddon": {
    "enabled": true
  },
  "LiteBuildConfig": {
    "contents": [
      "content"
    ]
  }
}
